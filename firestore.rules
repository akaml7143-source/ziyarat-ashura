rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && request.auth.uid == "WvoTCtdUdYhbMluOwfwmBg6CJSL2";
    }

    function isConversationUser(conversationId) {
      return signedIn() && request.auth.uid == conversationId;
    }

    match /app_updates/{updateId} {
      allow read: if true;
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly([
          'type', 'titleAr', 'bodyAr', 'titleFa', 'bodyFa', 'createdAt', 'createdBy'
        ])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.titleAr is string
        && request.resource.data.bodyAr is string
        && request.resource.data.titleFa is string
        && request.resource.data.bodyFa is string
        && request.resource.data.titleAr.size() > 0
        && request.resource.data.bodyAr.size() > 0
        && request.resource.data.titleFa.size() > 0
        && request.resource.data.bodyFa.size() > 0
        && request.resource.data.titleAr.size() <= 160
        && request.resource.data.titleFa.size() <= 160
        && request.resource.data.bodyAr.size() <= 3000
        && request.resource.data.bodyFa.size() <= 3000
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isOwner();
    }

    match /conversations/{conversationId} {
      allow read: if isOwner() || isConversationUser(conversationId);

      allow create: if isOwner()
        || (isConversationUser(conversationId)
          && request.resource.data.uid == request.auth.uid);

      allow update: if isOwner()
        || (isConversationUser(conversationId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt'])
          && request.resource.data.updatedAt == request.time);

      allow delete: if isOwner();

      match /messages/{messageId} {
        allow read: if isOwner() || isConversationUser(conversationId);

        allow create: if signedIn()
          && (isOwner() || isConversationUser(conversationId))
          && request.resource.data.keys().hasOnly([
            'senderUid', 'text', 'createdAt'
          ])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }

    // Public read-only data for the group khatma counters and status.
    // All writes are performed by trusted Cloud Functions.
    match /group_khatmas/{khatmaId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /group_khatma_stats/{statsId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /group_khatma_recent_reads/{readId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // Per-user cooldowns and participation records are private and server-managed.
    match /group_khatma_user_cooldowns/{userId} {
      allow read, write: if false;
    }

    match /group_khatma_participants/{participantId} {
      allow read, write: if false;
    }

    match /group_khatma_global_participants/{userId} {
      allow read, write: if false;
    }

    // Idempotency keys and full dedication details are never exposed to clients.
    match /group_khatma_idempotency/{requestKey} {
      allow read, write: if false;
    }

    match /group_khatma_private_reads/{readId} {
      allow read, write: if false;
    }
  }
}