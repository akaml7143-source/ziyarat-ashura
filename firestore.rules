rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && request.auth.uid == "WvoTCtdUdYhbMluOwfwmBg6CJSL2";
    }

    function isConversationUser(conversationId) {
      return signedIn() && request.auth.uid == conversationId;
    }

    match /conversations/{conversationId} {
      allow read: if isOwner() || isConversationUser(conversationId);

      allow create: if isOwner()
        || (isConversationUser(conversationId)
          && request.resource.data.uid == request.auth.uid);

      allow update: if isOwner()
        || (isConversationUser(conversationId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt'])
          && request.resource.data.updatedAt == request.time);

      allow delete: if isOwner();

      match /messages/{messageId} {
        allow read: if isOwner() || isConversationUser(conversationId);

        allow create: if signedIn()
          && (isOwner() || isConversationUser(conversationId))
          && request.resource.data.keys().hasOnly([
            'senderUid', 'text', 'createdAt'
          ])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }
  }
}