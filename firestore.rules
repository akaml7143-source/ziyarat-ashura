rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && request.auth.uid == "WvoTCtdUdYhbMluOwfwmBg6CJSL2";
    }

    function canAccessConversation(conversationId) {
      return signedIn()
        && (isOwner() || request.auth.uid == conversationId);
    }

    match /conversations/{conversationId} {
      allow read: if canAccessConversation(conversationId);
      allow create, update: if canAccessConversation(conversationId);
      allow delete: if isOwner();

      match /messages/{messageId} {
        allow read: if canAccessConversation(conversationId);

        allow create: if canAccessConversation(conversationId)
          && request.resource.data.keys().hasAll(['senderUid', 'text', 'createdAt'])
          && request.resource.data.keys().hasOnly(['senderUid', 'text', 'createdAt'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }
  }
}